<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<Pane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="paagbat.controller.Sales">
   <children>
      <HBox alignment="CENTER" prefHeight="80.0" prefWidth="600.0" style="-fx-background-color: #c9a9ea;">
         <children>
            <Label prefHeight="40.0" prefWidth="162.0" text="Sales Table">
               <font>
                  <Font name="System Bold" size="28.0" />
               </font>
            </Label>
         </children>
      </HBox>
      <Button alignment="CENTER" contentDisplay="CENTER" layoutX="127.0" layoutY="325.0" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#handleAdd" prefHeight="27.0" prefWidth="102.0" text="Add new sale">
         <font>
            <Font size="14.0" />
         </font></Button>
      <Button alignment="CENTER" contentDisplay="CENTER" layoutX="371.0" layoutY="325.0" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#handleDelete" prefHeight="27.0" prefWidth="102.0" text="Remove sale">
         <font>
            <Font size="14.0" />
         </font></Button>
      <Button alignment="CENTER" contentDisplay="CENTER" layoutX="14.0" layoutY="93.0" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#handleReturn" prefHeight="27.0" prefWidth="29.0" text="↩" />
      <TableView layoutX="178.0" layoutY="100.0" prefHeight="200.0" prefWidth="244.0" fx:id="tableViewSales">
        <columns>
          <TableColumn prefWidth="75.0" text="Sale Id" fx:id="tableColumnId"/>
          <TableColumn prefWidth="75.0" text="User Id" fx:id="tableColumnUserId"/>
         <TableColumn prefWidth="75.0" text="Product Id" fx:id="tableColumnProductId"/>
        </columns>
      </TableView>
   </children>
</Pane>
